require "spaceship"
default_platform(:ios)

# fastlane's error message drops Apple's meta.associatedErrors, which is the only place
# "is not in valid state" says what is actually missing.
Spaceship::ConnectAPI::APIClient.prepend(Module.new do
  def handle_response(response)
    if response.body.kind_of?(Hash) && response.body["errors"]
      UI.error(JSON.pretty_generate(response.body["errors"]))
    end
    super
  end
end)

platform :ios do
  desc "Submit latest TestFlight build to App Store for review"
  lane :submit_for_review do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_API_KEY_ID"],
      issuer_id: ENV["APPSTORE_API_ISSUER_ID"],
      key_content: ENV["APPSTORE_API_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    latest_testflight_build_number(api_key: api_key, app_identifier: "id.homebase.feed")
    app_version = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION]
    # deliver only expands a "default" release note onto languages it is told about.
    locales = Spaceship::ConnectAPI::App.find("id.homebase.feed")
      .get_live_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
      .get_app_store_version_localizations.map(&:locale)

    # Every build ships a new marketing version, so deliver must create the App Store version
    # itself; without app_version it reuses a stale one or finds none.
    deliver(
      api_key: api_key,
      app_identifier: "id.homebase.feed",
      app_version: app_version,
      languages: locales,

      skip_binary_upload: true,
      skip_screenshots: true,
      # Apple rejects an update with empty "What's New", so metadata upload stays on for release_notes only.
      skip_metadata: false,
      release_notes: { "default" => ENV.fetch("RELEASE_NOTES", "").strip.empty? ? "Bug fixes and improvements." : ENV["RELEASE_NOTES"] },

      submit_for_review: true,
      automatic_release: true,

      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      },

      run_precheck_before_submit: false,
      force: true
    )
  end
end
