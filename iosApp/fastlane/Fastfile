default_platform(:ios)

platform :ios do
  desc "Submit latest TestFlight build to App Store for review"
  lane :submit_for_review do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_API_KEY_ID"],
      issuer_id: ENV["APPSTORE_API_ISSUER_ID"],
      key_content: ENV["APPSTORE_API_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    deliver(
      api_key: api_key,
      app_identifier: "id.homebase.feed",

      # Skip upload, just submit existing build
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,

      # Don't specify build_number - will use latest
      # build_number: nil,  # Remove this line entirely

      # Required metadata (minimal)
      submit_for_review: true,
      automatic_release: false,

      # Submission info
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      },

      run_precheck_before_submit: false,
      force: true
    )
  end
end