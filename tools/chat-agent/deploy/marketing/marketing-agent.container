# ~marketing/.config/containers/systemd/marketing-agent.container  (unit: marketing-agent.service)
[Unit]
Description=Homebase marketing agent
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/marketing-agent:latest
ContainerName=marketing-agent
UserNS=keep-id
GroupAdd=2000
Network=pasta:-4
DNS=1.1.1.1
DNS=9.9.9.9
Volume=%h/data:/data
Volume=%h/workspace:/workspace
Volume=%h/home:/home/agent
EnvironmentFile=%h/secrets.env
PodmanArgs=--memory=6g --cpus=4 --pids-limit=2048
Exec=watch --profile marketing

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
