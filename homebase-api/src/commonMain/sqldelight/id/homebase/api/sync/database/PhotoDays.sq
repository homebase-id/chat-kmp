import kotlin.uuid.Uuid;

-- Both queries work out the local day in SQLite, so they always agree. Outside 1970-2037 SQLite guesses a zone's
-- summer time, so a photo near midnight can land a day off from kotlinx-datetime: place photos by these days.
dayCounts:
SELECT CAST(julianday(date(userDate / 1000.0, 'unixepoch', 'localtime')) - 2440587.5 AS INTEGER) AS day, count(*) AS photos
FROM DriveMainIndex
WHERE identityId = :identityId AND driveId = :driveId AND fileSystemType = 0 AND fileType = :fileType AND fileState = 1
  -- SQLite has no date outside the years 0 to 9999 (a userDate in microseconds, say): such a photo has no day.
  -- A day inside them, so no time zone pushes a date out. The + keeps SQLite on the covering index; a range on
  -- userDate read every row (924 ms, not 62, on a Pixel 5).
  AND +userDate BETWEEN -62167132800000 AND 253402214399999
GROUP BY day
ORDER BY day DESC;

-- A range on userDate, so the index serves it.
dayOf:
SELECT CAST(julianday(date(CAST(:userDate AS INTEGER) / 1000.0, 'unixepoch', 'localtime')) - 2440587.5 AS INTEGER) AS day,
  count(*) AS photos,
  CAST(strftime('%s', date(CAST(:userDate AS INTEGER) / 1000.0, 'unixepoch', 'localtime'), 'utc') AS INTEGER) * 1000 AS startMs,
  CAST(strftime('%s', date(CAST(:userDate AS INTEGER) / 1000.0, 'unixepoch', 'localtime', '+1 day'), 'utc') AS INTEGER) * 1000 AS endMs
FROM DriveMainIndex
WHERE identityId = :identityId AND driveId = :driveId AND fileSystemType = 0 AND fileType = :fileType AND fileState = 1
  AND userDate >= CAST(strftime('%s', date(CAST(:userDate AS INTEGER) / 1000.0, 'unixepoch', 'localtime'), 'utc') AS INTEGER) * 1000
  AND userDate < CAST(strftime('%s', date(CAST(:userDate AS INTEGER) / 1000.0, 'unixepoch', 'localtime', '+1 day'), 'utc') AS INTEGER) * 1000;
