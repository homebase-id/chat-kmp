import kotlin.uuid.Uuid;

-- Photos only (PhotobaseProtocol.PhotoFileType), so chat writes don't keep it; a query uses it only when it names
-- fileType 7201 itself, not as a parameter.
CREATE INDEX IF NOT EXISTS IdxPhotoShelf ON DriveMainIndex(identityId, driveId, archivalStatus, fileState, userDate)
  WHERE fileType = 7201 AND fileSystemType = 0;

-- A photo's day is its local date by SQLite, the one expression every query here uses. Outside 1970-2037 SQLite
-- guesses a zone's summer time, so a photo near midnight can land a day off from kotlinx-datetime: place photos by
-- these days.
dayCounts:
SELECT CAST(julianday(date(userDate / 1000.0, 'unixepoch', 'localtime')) - 2440587.5 AS INTEGER) AS day, count(*) AS photos
FROM DriveMainIndex
WHERE identityId = :identityId AND driveId = :driveId AND fileSystemType = 0 AND fileType = 7201 AND fileState = 1
  AND archivalStatus = :archivalStatus
  -- SQLite has no date outside the years 0 to 9999 (a userDate in microseconds, say): such a photo has no day.
  -- A day inside them, so no time zone pushes a date out. The + keeps SQLite on IdxPhotoShelf; a range on
  -- userDate read every row (924 ms, not 62, on a Pixel 5).
  AND +userDate BETWEEN -62167132800000 AND 253402214399999
GROUP BY day
ORDER BY day DESC;

-- Outside dayCounts' bounds, so a photo it leaves out has no day here either: -2147483648, since SQLDelight types this
-- as never NULL.
dayNumberOf:
SELECT CASE WHEN CAST(:userDate AS INTEGER) BETWEEN -62167132800000 AND 253402214399999
  THEN CAST(julianday(date(CAST(:userDate AS INTEGER) / 1000.0, 'unixepoch', 'localtime')) - 2440587.5 AS INTEGER)
  ELSE -2147483648
END AS day;

-- By dayCounts' own day expression, so the two can't disagree. The userDate range lets the index serve it, with a
-- day to spare each side since no zone is more than 14 hours from UTC.
photosOnDay:
SELECT count(*) FROM DriveMainIndex
WHERE identityId = :identityId AND driveId = :driveId AND fileSystemType = 0 AND fileType = 7201 AND fileState = 1
  AND archivalStatus = :archivalStatus
  AND userDate >= (CAST(:day AS INTEGER) - 1) * 86400000
  AND userDate < (CAST(:day AS INTEGER) + 2) * 86400000
  AND CAST(julianday(date(userDate / 1000.0, 'unixepoch', 'localtime')) - 2440587.5 AS INTEGER) = :day;

-- Newest first, by the same day expression and spare UTC day each side as photosOnDay.
photosOnDays:
SELECT CAST(julianday(date(userDate / 1000.0, 'unixepoch', 'localtime')) - 2440587.5 AS INTEGER) AS day, jsonHeader
FROM DriveMainIndex
WHERE identityId = :identityId AND driveId = :driveId AND fileSystemType = 0 AND fileType = 7201 AND fileState = 1
  AND archivalStatus = :archivalStatus
  AND userDate >= (CAST(:fromDay AS INTEGER) - 1) * 86400000
  AND userDate < (CAST(:toDay AS INTEGER) + 2) * 86400000
  AND CAST(julianday(date(userDate / 1000.0, 'unixepoch', 'localtime')) - 2440587.5 AS INTEGER) BETWEEN :fromDay AND :toDay
ORDER BY userDate DESC, rowId DESC;

headersOf:
SELECT jsonHeader FROM DriveMainIndex
WHERE identityId = :identityId AND driveId = :driveId AND fileId IN :fileIds;

headersOnShelf:
SELECT jsonHeader FROM DriveMainIndex
WHERE identityId = :identityId AND driveId = :driveId AND fileSystemType = 0 AND fileType = 7201 AND fileState = 1
  AND archivalStatus = :archivalStatus;
