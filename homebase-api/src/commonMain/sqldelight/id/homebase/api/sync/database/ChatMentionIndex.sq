import kotlin.uuid.Uuid;

-- One row per scanned incoming chat message: did its body mention the signed-in identity.
-- Written once per message (the scan is the only text work), read by the conversation-list
-- badge and the in-chat jump control. A new table: Schema.create adds it on existing installs
-- without a DATABASE_VERSION bump.
CREATE TABLE IF NOT EXISTS ChatMentionIndex(
   identityId BLOB AS Uuid NOT NULL,
   driveId BLOB AS Uuid NOT NULL,
   uniqueId BLOB AS Uuid NOT NULL,
   groupId BLOB AS Uuid NOT NULL,
   userDate INTEGER NOT NULL,
   mentionsMe INTEGER NOT NULL,
   PRIMARY KEY(identityId, driveId, uniqueId)
);

CREATE INDEX IF NOT EXISTS idx_mention_group
  ON ChatMentionIndex(identityId, groupId, mentionsMe, userDate);

-- Unread, non-self, live messages that have not been scanned yet. Same unread predicate as
-- ChatReadCount.selectAllUnreadCount, so the scan is bounded to what the badge counts.
selectUnscannedUnread:
SELECT d.driveId, d.uniqueId, d.groupId, d.userDate, d.jsonHeader
FROM DriveMainIndex AS d
LEFT JOIN ChatReadCount c ON d.groupId = c.groupId
WHERE d.identityId = :identityId
  AND d.fileType = 7878
  AND d.dataType = 0
  AND (c.lastReadTime IS NULL OR d.userDate > c.lastReadTime)
  AND d.groupId IS NOT NULL
  AND d.uniqueId IS NOT NULL
  AND d.originalAuthor IS NOT NULL
  AND d.originalAuthor != :selfDomain
  AND d.fileState != 0
  AND d.archivalStatus != 2
  AND NOT EXISTS (
    SELECT 1 FROM ChatMentionIndex m
    WHERE m.identityId = d.identityId AND m.driveId = d.driveId AND m.uniqueId = d.uniqueId
  );

upsertScanned:
INSERT OR REPLACE INTO ChatMentionIndex(identityId, driveId, uniqueId, groupId, userDate, mentionsMe)
VALUES (?, ?, ?, ?, ?, ?);

-- Unread mentions per conversation. Joins back to DriveMainIndex so a message deleted after it
-- was scanned stops counting.
selectUnreadMentionCounts:
SELECT m.groupId, COUNT(*) AS mentionCount
FROM ChatMentionIndex m
LEFT JOIN ChatReadCount c ON m.groupId = c.groupId
JOIN DriveMainIndex d
  ON d.identityId = m.identityId AND d.driveId = m.driveId AND d.uniqueId = m.uniqueId
WHERE m.identityId = ?
  AND m.mentionsMe = 1
  AND (c.lastReadTime IS NULL OR m.userDate > c.lastReadTime)
  AND d.fileState != 0
  AND d.archivalStatus != 2
GROUP BY m.groupId;

-- Oldest live mention in a conversation strictly after a given userDate.
selectOldestMentionAfter:
SELECT m.driveId, m.uniqueId, m.groupId, m.userDate
FROM ChatMentionIndex m
JOIN DriveMainIndex d
  ON d.identityId = m.identityId AND d.driveId = m.driveId AND d.uniqueId = m.uniqueId
WHERE m.identityId = ?
  AND m.groupId = ?
  AND m.mentionsMe = 1
  AND m.userDate > ?
  AND d.fileState != 0
  AND d.archivalStatus != 2
ORDER BY m.userDate ASC
LIMIT 1;

-- Live mentions in a conversation strictly after a given userDate; the jump control's count.
countMentionsAfter:
SELECT COUNT(*)
FROM ChatMentionIndex m
JOIN DriveMainIndex d
  ON d.identityId = m.identityId AND d.driveId = m.driveId AND d.uniqueId = m.uniqueId
WHERE m.identityId = ?
  AND m.groupId = ?
  AND m.mentionsMe = 1
  AND m.userDate > ?
  AND d.fileState != 0
  AND d.archivalStatus != 2;
