        <list />
      </option>
      <option name="taskNames">
        <list>
          <option value=":webApp:wasmJsBrowserDevelopmentRun" />
        </list>
      </option>
      <option name="vmOptions" />
    </ExternalSystemSettings>
    <GradleScriptDebugEnabled>false</GradleScriptDebugEnabled>
    <method v="2" />
  </configuration>
</component>
